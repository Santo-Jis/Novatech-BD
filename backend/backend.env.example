# ============================================================
# ZovoriX Management System — Environment Variables
# এই ফাইলটি template। আসল .env ফাইলে আসল মান বসান।
# .env ফাইল কখনো GitHub-এ push করবেন না!
# cp .env.example .env
# ============================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Error Tracking (Sentry) ──────────────────────────────────
# খালি রাখলে Sentry পুরোপুরি off থাকবে (dev/local-এ স্বাভাবিক)।
# sentry.io-তে project বানিয়ে DSN বসান। production-এ (Render) বসানো জরুরি।
SENTRY_DSN=

# ─── Database (Supabase PostgreSQL) ──────────────────────────
DB_HOST=your_supabase_host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_SSL=true
# Supabase CA Certificate (base64 encoded)
# ১. Supabase Dashboard → Settings → Database → SSL Certificate → Download → ca.pem
# ২. Linux/Mac: base64 -w 0 ca.pem
#    Windows:   certutil -encode ca.pem tmp.b64 && findstr /v CERTIFICATE tmp.b64
# ৩. নিচে base64 string paste করুন (Render env-এও একই ভাবে)
DB_SSL_CA=your_base64_encoded_supabase_ca_cert

# ─── JWT Secrets ─────────────────────────────────────────────
# generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_ACCESS_SECRET=your_access_secret_key_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRES=7d

# ✅ Customer portal-এর জন্য আলাদা secret (employee token থেকে আলাদা রাখা বাধ্যতামূলক)
JWT_PORTAL_SECRET=your_portal_secret_key_min_64_chars

# ─── AES-256 Encryption (SMS API key এনক্রিপশনের জন্য) ──────
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# ─── Claude AI ───────────────────────────────────────────────
CLAUDE_API_KEY=your_claude_api_key

# ─── SMS Gateway ─────────────────────────────────────────────
SMS_API_KEY=your_sms_api_key
SMS_DEVICE_ID=your_device_id
SMS_SENDER_ID=ZovoriX

# ─── Email / Brevo SMTP ──────────────────────────────────────
# Render SMTP block করে — Brevo ব্যবহার করা হচ্ছে (smtp-relay.brevo.com)
EMAIL_ENABLED=true
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=your_brevo_login@email.com
EMAIL_PASS=your_brevo_smtp_key
EMAIL_FROM=ZovoriX <noreply@yourdomain.com>

# ─── WhatsApp Gateway (provider-agnostic adapter) ────────────
# ✅ FIX (Phase 0): আগে এই দুটো variable কোথাও ডকুমেন্ট করা ছিল না,
# অথচ কোডে (portalWhatsapp.service.js, invoiceWhatsapp.service.js,
# আর Phase 2 audit-এ পাওয়া একটা তৃতীয় জায়গা — invoice.service.js)
# API_SECRET-এর একটা হার্ডকোডেড ডিফল্ট fallback ছিল — ডকুমেন্ট না থাকায়
# deploy করার সময় ভুলে যাওয়া সহজ ছিল। ব্যবহার হয় OTP/security-alert
# (portal), invoice verify-link, আর invoice PDF (sales) পাঠাতে।
#
# ✅ NEW (Phase 2): WHATSAPP_PROVIDER — backend/src/services/
# whatsappGateway.service.js প্রতিটা WhatsApp send-এর জন্য এই একটা
# জায়গা থেকেই BAILEYS_URL/API_SECRET পড়ে (আগে ৩টা আলাদা ফাইলে আলাদা
# কপি ছিল)। এখন শুধু 'baileys' বাস্তবায়িত — অফিসিয়াল WhatsApp Business
# API (Twilio/Meta Cloud/BSP) এখনো vendor-সিদ্ধান্ত বাকি বলে বাস্তবায়িত
# হয়নি, বেছে নিলে স্পষ্ট error দেবে।
WHATSAPP_PROVIDER=baileys
BAILEYS_URL=http://localhost:3001
# generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# — Baileys গেটওয়ে সার্ভিসেও ঠিক এই একই মান সেট করতে হবে (দুই পাশে মিলতে হবে)
API_SECRET=your_baileys_gateway_shared_secret

# ─── File Upload ─────────────────────────────────────────────
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5242880

# ─── Cloudinary (Image Upload) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ─── Firebase (Push Notification / Realtime DB) ──────────────
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Firebase Admin SDK service account JSON (একলাইনে stringify করা)
# node -e "console.log(JSON.stringify(require('./serviceAccount.json')))"
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ─── Google ──────────────────────────────────────────────────
# ⚠️  GOOGLE_CLIENT_ID ছাড়া customer portal-এর Google OAuth aud check কাজ করবে না।
#     যেকোনো app-এর valid Google token দিয়ে login সম্ভব হবে — server উঠবেই না।
#     Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_MAPS_KEY=your_google_maps_api_key
GOOGLE_DRIVE_SCRIPT_URL=https://script.google.com/macros/s/your-script-id/exec

# ─── Frontend URL (CORS) ─────────────────────────────────────
# ⚠️ এটা শুধু CORS-এর জন্য — server.js এটাকে comma দিয়ে split করে,
#    এবং wildcard (*) সাপোর্ট করে। একাধিক/preview origin এখানে দিন।
#    এই raw value কখনো সরাসরি customer-facing লিংক বানাতে ব্যবহার করবেন না —
#    করলে WhatsApp/Email-এর লিংকে comma আর literal "*" ঢুকে ভেঙে যাবে।
# Production-এ Vercel URL দিন। একাধিক হলে comma দিয়ে আলাদা করুন।
# FRONTEND_URL=https://zovorix.vercel.app,https://zovorix-git-main.vercel.app
FRONTEND_URL=http://localhost:3000

# ─── Public App URL (customer-facing লিংক) ────────────────────
# WhatsApp portal link, email verify link, invoice PDF link — এসবের
# জন্য ব্যবহৃত হয় (getPublicAppUrl() হেল্পার দেখুন)। এখানে ঠিক
# ONE clean URL দিন — comma বা * দেবেন না, এটা CORS list না।
# PUBLIC_APP_URL=https://novatech-bd-kqrn.vercel.app
PUBLIC_APP_URL=http://localhost:5173

# ─── Render Keep-Alive ───────────────────────────────────────
# Render dashboard থেকে service URL কপি করো (free tier ঘুম থেকে জাগাতে)
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com

# ============================================================
# Frontend — Vite
# এই ফাইলে রাখবেন না। frontend/.env ফাইল আলাদা করে তৈরি করুন:
#   cp frontend/.env.example frontend/.env
# ============================================================
